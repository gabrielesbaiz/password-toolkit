{
    "name": "gabrielesbaiz/password-toolkit",
    "description": "Generate memorable, human-friendly passwords from curated dictionaries, in any language.",
    "keywords": [
        "Gabriele Sbaiz",
        "laravel",
        "password",
        "password-generator",
        "password-toolkit",
        "memorable-password"
    ],
    "homepage": "https://github.com/gabrielesbaiz/password-toolkit",
    "license": "MIT",
    "authors": [
        {
            "name": "Gabriele Sbaiz",
            "email": "gabriele@sbaiz.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "illuminate/contracts": "^10.0||^11.0||^12.0||^13.0",
        "illuminate/support": "^10.0||^11.0||^12.0||^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^2.9||^3.1",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^7.10.0||^8.1.1",
        "orchestra/testbench": "^8.22.0||^9.0.0||^10.0.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-arch": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "pestphp/pest-plugin-watch": "^3.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "Gabrielesbaiz\\PasswordToolkit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gabrielesbaiz\\PasswordToolkit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "lint": [
            "@format",
            "@analyse"
        ],
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gabrielesbaiz\\PasswordToolkit\\PasswordToolkitServiceProvider"
            ],
            "aliases": {
                "PasswordToolkit": "Gabrielesbaiz\\PasswordToolkit\\Facades\\PasswordToolkit"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
